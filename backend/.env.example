# Free-tier provider chain:
#   GEMINI_API_KEY alone → tries 3 models in order (2.5 Flash → 2.5 Flash Lite → 3.1 Flash Lite).
#   GEMINI_API_KEY_2/_3 → optional extra keys from OTHER Google accounts (more quota, not more models).
# Get Gemini key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI2_MODEL=gemini-2.5-flash-lite
# GEMINI3_MODEL=gemini-3.1-flash-lite

# Optional: extra Gemini keys from DIFFERENT Google accounts only.
# Same key repeated here does nothing (deduped). AI Studio shares quota per account.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Final fallback. Get free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional legacy fallback — CryptoPanic free tier ends April 2026; paid plan required.
# News works without this key via NS3 News + Google News RSS.
CRYPTOPANIC_API_KEY=

# ── Real trading ───────────────────────────────────────────────────────
# Trading runs on Binance Spot TESTNET by default (fake funds, no real money).
# Keep this empty/false for testnet. Set "true" ONLY after sign-off + security review.
ENABLE_BINANCE_MAINNET=

# Shared DEMO key for the Spot Testnet portfolio (optional).
# Get free testnet keys + test funds at: https://testnet.binance.vision
# When set, everyone shares this one testnet account and the UI unlocks
# without each user linking a key in Settings. Enable "Spot & Margin Trading",
# keep "Withdrawals" DISABLED.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Mainnet (real money) keys — used only when ENABLE_BINANCE_MAINNET=true.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Master key for encrypting per-user API keys at rest (AES-256-GCM).
# A dev fallback is used if unset — set a strong value for any shared deployment.
CRYPTOLENS_MASTER_KEY=
